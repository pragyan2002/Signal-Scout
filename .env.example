# LLM provider — default is Cerebras (1M tokens/day free, no card).
# Get a key at https://cloud.cerebras.ai/
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=llama3.1-8b

# Min gap between LLM calls (ms). 13000 keeps you under Cerebras free 5 RPM.
# Drop to e.g. 2000 on Groq / paid tiers.
LLM_MIN_INTERVAL_MS=13000

# Other providers (uncomment one, paste matching key above):
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
